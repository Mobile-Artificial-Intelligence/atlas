<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Atlas is fully offline: strip the network permissions that MapLibre's
         AAR manifest declares, so the merged APK holds none of them. Enforced
         by the checkNoNetworkPermissions build task. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"
        tools:node="remove" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The :graph process holds the whole bucket in memory during builds. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- NavigationService keeps the GPS fix loop alive behind a
         location-type foreground notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- GraphBuildService holds a partial wake lock in 10-min slices so a
         long bucket build survives the screen going off. Normal-level
         permission, no runtime grant needed. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".AtlasApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atlas"
        android:allowBackup="false"
        android:largeHeap="true">

        <activity
            android:name=".AtlasActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bucket builds run in their own process: a builder OOM must never
             take the UI (or a running navigation) down with it. -->
        <service
            android:name=".services.GraphBuildService"
            android:process=":graph"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Navigation runs in the main process: its state is UI-facing and
             its footprint is a few MB (GPS fixes + TTS). -->
        <service
            android:name=".services.NavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>