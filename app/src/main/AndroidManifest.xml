<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Atlas is fully offline: strip the network permissions that MapLibre's
         AAR manifest declares, so the merged APK holds none of them. Enforced
         by the checkNoNetworkPermissions build task. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"
        tools:node="remove" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The :graph process holds the whole bucket in memory during builds. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- NavigationService keeps the GPS fix loop alive behind a
         location-type foreground notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- GraphBuildService holds a partial wake lock in 10-min slices so a
         long bucket build survives the screen going off. Normal-level
         permission, no runtime grant needed. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The floating turn banner (NavigationService's overlay window) is a
         TYPE_APPLICATION_OVERLAY, gated by this appop rather than a runtime
         dialog — the Settings tab launches the system grant screen. Not in
         NoNetworkPermissionCheck's forbidden list, so the offline guarantee
         is untouched. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android Auto (phone projection): turn-by-turn runs on the library's
         navigation templates (NavigationTemplate + NavigationManager), which
         hosts require this permission for since car-app 1.3+. ACCESS_SURFACE
         is deliberately absent — the car screen never draws into the host
         surface, it only sends templates. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />

    <!-- Package visibility (Android 11+): without these the system's
         AppsFilter hides other apps' speech components from Atlas, and the
         TTS engine fails to bind even though it is installed and selected
         as the system default — the init callback just gets ERROR. A
         third-party engine (e.g. a custom TTS like the user's own) is
         invisible without the query; preinstalled system engines are
         exempt, which is why this only bites on real devices. -->
    <queries>
        <!-- TextToSpeech binds services handling this action. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Voice search launches a recognizer ACTIVITY by this action
             (RecognizeIntent), not the SpeechRecognizer service API — so
             android.speech.RecognitionService is not queried: the service
             binding path is never used and the activity query is what
             makes the mic button's resolver work. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".AtlasApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atlas"
        android:allowBackup="false"
        android:largeHeap="true">

        <activity
            android:name=".AtlasActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Geographic URIs from other apps (RFC 5870 + the q= z=
                 extensions): another map app, a browser link, or an NFC tag
                 can hand Atlas a coordinate or place to look up offline.
                 The request is parsed by MapIntentParser and lands in the
                 map state via ExternalMapIntentHandler (onCreate for a
                 cold start, onNewIntent for the running activity — the
                 singleTop launch mode means both must be handled). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

        <!-- Bucket builds run in their own process: a builder OOM must never
             take the UI (or a running navigation) down with it. -->
        <service
            android:name=".services.GraphBuildService"
            android:process=":graph"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Navigation runs in the main process: its state is UI-facing and
             its footprint is a few MB (GPS fixes + TTS). -->
        <service
            android:name=".services.NavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Android Auto (phone projection): advertises the CarAppService to
             the Android Auto host. The modern descriptor pattern — the host
             reads res/xml/automotive_app_desc.xml (template support), not
             the legacy value="true" flag. The DHU/head unit binds the
             service below. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Every shipping host speaks level >= 2; level 2 covers the
             MessageInfo-as-NavigationInfo variant used for the GPS-wait and
             Recalculating states (level 1 only has Step). -->
        <meta-data
            android:name="androidx.car.app.minCarAppApiLevel"
            android:value="2" />

        <service
            android:name=".auto.AtlasCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>
    </application>
</manifest>