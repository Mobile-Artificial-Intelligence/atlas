<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme only: all real theming happens in Compose (Material 3
         dynamic color). This just gives the window a dark-aware background so
         there is no white flash before Compose draws. -->
    <style name="Theme.Atlas" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/background_dark</item>
    </style>
</resources>